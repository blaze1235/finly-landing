  "animationGuidelines": {
    "globalRules": [
      "All screen transitions use Smart Animate in Figma — ensure layer names match between frames.",
      "Elements that persist across frames (NavBar, StatusBar) must have identical names and properties.",
      "Use the Syne variable font for all display text; DM Sans for body copy.",
      "Micro-interactions (button tap, toggle, category select) use 120ms ease-out.",
      "Page-level transitions use 400ms cubic-bezier(0.16, 1, 0.3, 1).",
      "Donut chart draws clockwise from 12 o'clock using strokeDashoffset animation."
    ],
    "figmaPrototypingSteps": [
      "1. Duplicate each frame into Figma as a 375×812 frame.",
      "2. Apply 'Change To' connections between frames using the Prototype panel.",
      "3. Set Smart Animate with matching layer names for shared elements.",
      "4. Use Figma's 'After Delay' trigger for auto-advancing splash and toast frames.",
      "5. Use 'On Tap' trigger for all navigation and button interactions.",
      "6. For the donut chart: animate the strokeDashoffset via a variant component."
    ],
    "entryAnimations": {
      "fadeUp": { "opacity": [0, 1], "y": [20, 0], "duration": 400, "easing": "cubic-bezier(0.16,1,0.3,1)" },
      "scaleIn": { "scale": [0.8, 1], "opacity": [0, 1], "duration": 350, "easing": "cubic-bezier(0.34,1.56,0.64,1)" },
      "slideDown": { "y": [-80, 0], "opacity": [0, 1], "duration": 300, "easing": "cubic-bezier(0.16,1,0.3,1)" },
      "barGrow": { "width": ["0%", "target%"], "duration": 600, "easing": "cubic-bezier(0.16,1,0.3,1)" },
      "stagger": 60
    }
  }
